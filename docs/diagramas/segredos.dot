digraph segredos {graph [rankdir=LR,bgcolor="white",pad="0.3",nodesep="0.45",ranksep="0.55",fontname="Arial"]; node [shape=box,style="rounded,filled",fillcolor="#EAF2FF",color="#3563A4",fontname="Arial",fontsize=13,margin="0.18,0.12"]; edge [color="#526D82",fontname="Arial",fontsize=10];sa [label="ServiceAccount do workload"]; id [label="Identidade AWS\nIRSA ou Pod Identity: confirmar",fillcolor="#FFF3D6",color="#B98A25"]; iam [label="Role e permissões IAM"]; sm [label="Secrets Manager\nsegredos e versões"]; spc [label="SecretProviderClass\nreferências e configuração"]; csi [label="CSI Driver + provider AWS"]; vol [label="Arquivo montado no pod"]; app [label="Aplicação\nleitura / recarga"]; sa -> id -> iam; iam -> csi [label="autoriza acesso"]; sm -> csi [label="recupera versão"]; spc -> csi; csi -> vol [label="atualização: comprovar"]; vol -> app [label="adoção: comprovar"]; }