digraph certflow {graph [rankdir=LR,bgcolor="white",pad="0.3",nodesep="0.45",ranksep="0.55",fontname="Arial"]; node [shape=box,style="rounded,filled",fillcolor="#EAF2FF",color="#3563A4",fontname="Arial",fontsize=13,margin="0.18,0.12"]; edge [color="#526D82",fontname="Arial",fontsize=10];label="CertFlow — desenho recuperado; implantação não comprovada"; labelloc=t; fontsize=16; s3 [label="S3\nartefatos"]; op [label="CertFlow Operator"]; efs [label="EFS / PVC\npublicação atômica"]; sm [label="Secrets Manager\nsenhas"]; csi [label="CSI Driver\narquivos de segredos"]; lib [label="Biblioteca TLS Registry\ncertificado + senha compatíveis"]; app [label="Aplicação Quarkus\nrecarga TLS sem reinício\nobjetivo a demonstrar",fillcolor="#FFF3D6",color="#B98A25"]; s3 -> op -> efs -> lib; sm -> csi -> lib; lib -> app;}