digraph auditoria {graph [rankdir=LR,bgcolor="white",pad="0.3",nodesep="0.45",ranksep="0.55",fontname="Arial"]; node [shape=box,style="rounded,filled",fillcolor="#EAF2FF",color="#3563A4",fontname="Arial",fontsize=13,margin="0.18,0.12"]; edge [color="#526D82",fontname="Arial",fontsize=10];lista [label="Entender os controles"]; escopo [label="Definir escopo e critérios"]; coleta [label="Coletar configuração\ne evidências"]; revisao [label="Conferir eficácia\ne fontes externas"]; plano [label="Registrar ações\ne comprovar encerramento"]; lista -> escopo -> coleta -> revisao -> plano;}